/* Composite widgets — objectName and dynamic properties. */

LabeledLineEdit QLabel {
    min-width: 72px;
    color: #b0b0b0;
}

LabeledLineEdit QLineEdit {
    min-width: 160px;
}

LabeledLineEdit[invalid="true"] QLineEdit {
    border: 1px solid #e85d5d;
    background-color: #5e3236;
}

#PathPicker QLineEdit {
    min-width: 200px;
}

#PathPickerBrowse {
    min-width: 88px;
}

#PropertiesBook {
    background-color: #3c3c3c;
}

#PropertiesBookTabs::pane {
    border: none;
    border-top: 1px solid #565656;
    background: #3c3c3c;
}

#PropertiesPanel {
    background-color: #3c3c3c;
}

#PropertiesPanelEmpty {
    color: #b0b0b0;
    padding: 10px 10px;
    font-size: 12px;
}

#PropertiesPanelError {
    color: #ff9a9a;
    padding: 4px 8px;
    background-color: #5e3236;
    border-radius: 3px;
    margin: 4px 8px;
}

#PropertiesColorSwatch {
    border: 1px solid #565656;
    border-radius: 3px;
    min-width: 22px;
    min-height: 20px;
    padding: 0;
}

#PropertiesColorEditor[invalid="true"] QLineEdit,
#PropertiesVecEditor[invalid="true"] QDoubleSpinBox,
#PropertiesNumberEditor[invalid="true"] QSpinBox,
#PropertiesNumberEditor[invalid="true"] QDoubleSpinBox,
PropertiesPanel QLineEdit[invalid="true"],
PropertiesPanel QSpinBox[invalid="true"],
PropertiesPanel QDoubleSpinBox[invalid="true"] {
    border: 1px solid #e85d5d;
    background-color: #5e3236;
}

#PropertiesPanel QLabel {
    color: #b0b0b0;
}

/* —— Properties: compact attribute-editor density ——
   Matches DCC attribute editors (Maya, Blender, Houdini): 12px text,
   ~20px fields, small radii. Row spacing lives in PropertiesPanel. */

#PropertiesBook,
#PropertiesPanel {
    font-size: 12px;
}

#PropertiesBookTabs QTabBar::tab {
    padding: 4px 10px;
    margin-right: 0;
}

#PropertiesPanel QLineEdit,
#PropertiesPanel QSpinBox,
#PropertiesPanel QDoubleSpinBox,
#PropertiesPanel QComboBox {
    border-radius: 3px;
    padding: 1px 5px;
    min-height: 18px;
    max-height: 18px;
}

#PropertiesPanel QSpinBox::up-button,
#PropertiesPanel QDoubleSpinBox::up-button,
#PropertiesPanel QSpinBox::down-button,
#PropertiesPanel QDoubleSpinBox::down-button {
    width: 12px;
}

#PropertiesPanel QComboBox::drop-down {
    width: 16px;
}

#PropertiesPanel QPushButton {
    border-radius: 3px;
    padding: 1px 8px;
    min-height: 18px;
}

#PropertiesPanel QCheckBox {
    spacing: 4px;
}

#PropertiesPanel QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border-radius: 3px;
}

#PropertiesPanel #PathPicker QLineEdit {
    min-width: 0;
}

#PropertiesPanel #PathPickerBrowse {
    min-width: 0;
}

/* Draggable labels: numeric row labels and vector X/Y/Z labels. */
#PropertiesPanel QLabel[scrub="true"]:hover {
    color: #eeeeee;
}

#PropertiesAxisLabel {
    color: #8c8c8c;
    padding: 0 0 0 2px;
}

#PropertiesSlider::groove:horizontal {
    height: 4px;
    background: #2f2f2f;
    border: 1px solid #565656;
    border-radius: 2px;
}

#PropertiesSlider::sub-page:horizontal {
    background: #6a6a6a;
    border: 1px solid #565656;
    border-radius: 2px;
}

#PropertiesSlider::handle:horizontal {
    width: 8px;
    margin: -5px 0;
    border-radius: 2px;
    background: #b0b0b0;
}

#PropertiesSlider::handle:horizontal:hover {
    background: #eeeeee;
}

#PropertiesSlider::handle:horizontal:disabled {
    background: #6a6a6a;
}

#NodeGraphView {
    border: 1px solid #565656;
    border-radius: 8px;
    background-color: #2f2f2f;
}

#NodeGraphDefaultContent {
    background: transparent;
    color: #eeeeee;
}

#SceneGraphTree {
    background-color: #3c3c3c;
}

#SceneGraphTreeView {
    border: none;
    border-radius: 0;
    background-color: #2f2f2f;
    padding: 4px;
}

#SceneViewportToolbar {
    spacing: 6px;
    padding: 6px 10px;
}

#SceneViewportToolbar QToolButton {
    padding: 6px 12px;
    font-weight: 500;
}

#SceneViewportToolbar QToolButton:checked {
    background-color: #4c8dff;
    color: #ffffff;
}

#SceneViewportSplitter::handle {
    background-color: #2f2f2f;
}

#SceneViewportSplitter::handle:hover {
    background-color: #4c8dff;
}

#SceneViewportCanvas {
    background-color: #5c5c5c;
    border: none;
}

RangeSlider {
    min-height: 24px;
    background-color: transparent;
}

CommandPalette QLineEdit {
    min-height: 22px;
}

CommandPalette QListWidget {
    background-color: #2f2f2f;
    border: 1px solid #565656;
    border-radius: 4px;
}

CommandPalette QListWidget::item {
    padding: 4px 8px;
}

CommandPalette QListWidget::item:selected {
    background-color: #3e5f8a;
    color: #eeeeee;
}

TagInput {
    background-color: #2f2f2f;
    border: 1px solid #565656;
    border-radius: 4px;
}

TagInput QLineEdit {
    border: none;
    background: transparent;
    min-width: 80px;
    padding: 2px 4px;
}

#TagChip {
    background-color: #4a4a4a;
    border: 1px solid #565656;
    border-radius: 8px;
}

#TagChip QLabel {
    color: #eeeeee;
    background: transparent;
}

#TagChip QToolButton {
    border: none;
    color: #b0b0b0;
    padding: 0 4px;
    background: transparent;
}

ToastStack {
    background: transparent;
}

Toast {
    background-color: #3c3c3c;
    color: #eeeeee;
    border: 1px solid #565656;
    border-radius: 6px;
}

Toast[level="warning"] {
    background-color: #4a4a4a;
    border: 1px solid #3e5f8a;
    color: #eeeeee;
}

Toast[level="error"] {
    background-color: #5e3236;
    color: #e85d5d;
    border: 1px solid #e85d5d;
}

Toast QLabel,
Toast QToolButton {
    background: transparent;
}

Toast QToolButton {
    border: none;
    color: #b0b0b0;
    padding: 0 4px;
}

BreadcrumbBar {
    background: transparent;
}

BreadcrumbBar QPushButton {
    background: transparent;
    border: none;
    color: #b0b0b0;
    padding: 2px 4px;
}

BreadcrumbBar QPushButton[current="true"] {
    color: #eeeeee;
    font-weight: 600;
}

#BreadcrumbChevron {
    color: #565656;
    background: transparent;
    padding: 0 2px;
}
