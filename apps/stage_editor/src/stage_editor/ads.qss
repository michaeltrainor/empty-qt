/* Qt Advanced Docking System in mtqt's dark palette (see mtqt base.qss tokens). */

ads--CDockContainerWidget {
    background: #2f2f2f;
}

ads--CDockContainerWidget > QSplitter {
    padding: 1px 0 0 0;
}

ads--CDockContainerWidget ads--CDockSplitter::handle {
    background: #2f2f2f;
}

ads--CDockAreaWidget {
    background: #3c3c3c;
}

ads--CDockAreaTitleBar {
    background: #2f2f2f;
    border-bottom: 1px solid #565656;
    min-height: 22px;
}

ads--CDockWidgetTab {
    background: #2f2f2f;
    border: none;
    border-right: 1px solid #565656;
    padding: 0 6px;
    qproperty-iconSize: 14px 14px;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #3c3c3c;
    border-bottom: 2px solid #4c8dff;
}

ads--CDockWidgetTab QLabel {
    background: transparent;
    color: #b0b0b0;
}

ads--CDockWidgetTab[activeTab="true"] QLabel {
    color: #eeeeee;
}

ads--CDockWidget {
    background: #3c3c3c;
    border: none;
}

ads--CTitleBarButton,
#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    padding: 0 2px;
}

#tabCloseButton:hover,
#dockAreaCloseButton:hover,
#detachGroupButton:hover,
#tabsMenuButton:hover {
    background: #4a4a4a;
}

ads--CFloatingDockContainer {
    background: #2f2f2f;
}
